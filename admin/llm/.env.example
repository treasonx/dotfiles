# Copy to .env and fill in. Already covered by admin/admin.gitignore.

# Optional. Needed for gated HuggingFace repos (some Llama, some Gemma).
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Required by Open WebUI for cookie signing. Generate with:
#   openssl rand -hex 32
WEBUI_SECRET_KEY=
