#!/usr/bin/env python3
"""Fuzzy-delete exited zellij sessions only."""

import re
import shutil
import subprocess
import sys

try:
    from j_lib import JParser
except ModuleNotFoundError:
    from executable_j_lib import JParser

ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
ALL_EXITED = "* all exited sessions"


def exited_sessions() -> list[tuple[str, str]]:
    """Return (name, raw_line) rows marked EXITED by `zellij ls`."""
    result = subprocess.run(["zellij", "ls"], capture_output=True, text=True)
    if result.returncode != 0 and "No" in result.stderr:
        return []

    sessions = []
    for raw in result.stdout.splitlines():
        line = ANSI_RE.sub("", raw).strip()
        if not line or "EXITED" not in line:
            continue
        sessions.append((line.split(None, 1)[0], line))
    return sessions


def fzf_select(lines: list[str]) -> list[str]:
    result = subprocess.run(
        ["fzf", "--multi", "--prompt=delete exited> ", "--height=~50%", "--reverse"],
        input="\n".join(lines),
        capture_output=True,
        text=True,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return []
    return result.stdout.splitlines()


def confirm(names: list[str]) -> bool:
    print("Delete exited zellij session(s)?")
    for name in names:
        print(f"  - {name}")
    try:
        answer = input("Type 'yes' to delete: ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    return answer == "yes"


def main() -> int:
    JParser(description="Select and delete exited zellij sessions").run()

    if shutil.which("fzf") is None:
        print("fzf not found", file=sys.stderr)
        return 1

    rows = exited_sessions()
    if not rows:
        print("No exited zellij sessions to delete.")
        return 0

    max_name = max([len(name) for name, _ in rows] + [len(ALL_EXITED)])
    lines = [ALL_EXITED, *[f"{name:<{max_name}}  {raw}" for name, raw in rows]]
    selected = fzf_select(lines)
    if not selected:
        return 0

    if any(line == ALL_EXITED for line in selected):
        names = [name for name, _ in rows]
    else:
        names = [line.split(None, 1)[0] for line in selected]

    if not confirm(names):
        print("Cancelled.")
        return 0

    exit_code = 0
    for name in names:
        result = subprocess.run(["zellij", "delete-session", name])
        if result.returncode != 0:
            exit_code = result.returncode
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
