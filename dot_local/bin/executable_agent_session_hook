#!/usr/bin/env python3
"""Track Claude Code / Codex CLI sessions for the Noctalia agent-sessions widget.

Invoked as a hook by both agents (JSON event on stdin), it maintains
~/.local/state/agent-sessions/sessions.json (canonical) and sessions.tsv
(pre-sorted mirror for the Luau widget) — one entry per live session with its
status (working / waiting / permission), cwd, and agent PID. The Noctalia v5
scripted widget (~/.config/noctalia/scripts/agent_sessions.lua, one slot per
session) polls the TSV and is nudged instantly via
`noctalia msg scripted-widget agent_slot_N all refresh` after every write.

Modes:
    agent_session_hook --agent claude      # ingest hook JSON from stdin
    agent_session_hook --agent codex       # same, for codex hooks
    agent_session_hook --prune             # drop entries whose process died
    agent_session_hook --focus SESSION_ID  # focus the session's niri window
    agent_session_hook --dump              # pretty-print current state

Set AGENT_SESSION_HOOK_DEBUG=1 to append raw hook payloads to
~/.local/state/agent-sessions/debug.log (useful to verify event shapes).

Notes:
  - Ingest never writes to stdout and always exits 0: agents interpret hook
    stdout/exit codes, so failures here must be invisible to them.
  - Codex has no SessionEnd hook; dead sessions are removed by PID-liveness
    pruning (the plugin runs --prune on a timer). PID start-time is stored to
    defeat PID reuse.
  - --focus walks the /proc PPid ancestor chain from the agent process to the
    terminal that niri knows about. Multiplexers (zellij/tmux) detach that
    chain; we then fall back to a unique window-title match on the cwd
    basename, else give up quietly (exit 1).
  - If codex hooks don't fire, codex may need `hooks = true` under
    `[features]` in ~/.codex/config.toml, and the hooks must be trusted once
    via /hooks in the codex TUI (again after every edit to hooks.json).
"""

import fcntl
import json
import os
import subprocess
import sys
import time
from pathlib import Path

from j_lib import JParser

STATE_DIR = Path.home() / ".local" / "state" / "agent-sessions"
STATE_FILE = STATE_DIR / "sessions.json"
TSV_FILE = STATE_DIR / "sessions.tsv"
LOCK_FILE = STATE_DIR / "sessions.json.lock"
DEBUG_LOG = STATE_DIR / "debug.log"

# Noctalia bar slots to nudge after every state change (see
# ~/.config/noctalia/config.toml [widget.agent_slot_N] blocks).
WIDGET_SLOTS = 5

# Entries without a usable PID fall back to age-based pruning.
STALE_SECONDS = 12 * 3600


def build_parser() -> JParser:
    parser = JParser(description="Track Claude/Codex sessions for the Noctalia bar widget")
    parser.add_argument("--agent", choices=["claude", "codex"],
                        help="Ingest a hook event (JSON on stdin) for this agent")
    parser.add_argument("--prune", action="store_true",
                        help="Remove entries whose process is gone")
    parser.add_argument("--focus", metavar="SESSION_ID",
                        help="Focus the niri window owning this session")
    parser.add_argument("--dump", action="store_true",
                        help="Pretty-print the current state file")
    return parser


# ── State file helpers ────────────────────────────────────────────────

def locked_lock_fd(budget: float = 1.0):
    """Acquire an exclusive flock on the lock file, or None if the budget runs out.

    The budget stays well under the agents' hook timeout so a stuck lock can
    never stall a Claude/codex turn.
    """
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    fd = os.open(LOCK_FILE, os.O_CREAT | os.O_RDWR, 0o644)
    deadline = time.monotonic() + budget
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            if time.monotonic() > deadline:
                os.close(fd)
                return None
            time.sleep(0.05)


def load_state() -> dict:
    try:
        return json.loads(STATE_FILE.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def save_state(state: dict) -> None:
    """Atomic writes (tmp + rename): readers must never see partial files.

    sessions.json is canonical; sessions.tsv is a pre-sorted, easily-parsed
    mirror for the Luau widget script (Luau has no JSON parser built in).
    """
    tmp = STATE_FILE.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(state, indent=1))
    os.replace(tmp, STATE_FILE)

    rows = sorted(state.items(), key=lambda kv: kv[1].get("started_at", 0))
    lines = []
    for sid, e in rows:
        fields = [sid, e.get("agent", ""), e.get("status", ""),
                  e.get("cwd", ""), e.get("model") or ""]
        lines.append("\t".join(f.replace("\t", " ").replace("\n", " ") for f in fields))
    tsv_tmp = TSV_FILE.with_suffix(".tsv.tmp")
    tsv_tmp.write_text("\n".join(lines) + ("\n" if lines else ""))
    os.replace(tsv_tmp, TSV_FILE)

    nudge_widgets()


def nudge_widgets() -> None:
    """Fire-and-forget IPC so the bar updates instantly (polling is the fallback)."""
    loop = "; ".join(
        f"noctalia msg scripted-widget agent_slot_{i} all refresh >/dev/null 2>&1"
        for i in range(1, WIDGET_SLOTS + 1)
    )
    try:
        subprocess.Popen(["sh", "-c", f"({loop}) &"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


# ── /proc helpers ─────────────────────────────────────────────────────

def proc_ppid(pid: int) -> int | None:
    try:
        for line in (Path("/proc") / str(pid) / "status").read_text().splitlines():
            if line.startswith("PPid:"):
                return int(line.split()[1])
    except (OSError, ValueError):
        pass
    return None


def proc_cmdline(pid: int) -> str:
    try:
        raw = (Path("/proc") / str(pid) / "cmdline").read_bytes()
        return raw.replace(b"\0", b" ").decode(errors="replace")
    except OSError:
        return ""


def proc_start_time(pid: int) -> int | None:
    """Process start time (field 22 of /proc/<pid>/stat) — survives PID reuse checks."""
    try:
        stat = (Path("/proc") / str(pid) / "stat").read_text()
        # comm (field 2) may contain spaces/parens; split after the last ')'.
        fields = stat.rsplit(")", 1)[1].split()
        return int(fields[19])  # field 22 overall; fields[0] here is field 3
    except (OSError, ValueError, IndexError):
        return None


def ancestors(pid: int) -> list[int]:
    """PIDs from `pid` up to (not including) PID 1, nearest first."""
    chain = []
    seen = set()
    while pid and pid > 1 and pid not in seen:
        chain.append(pid)
        seen.add(pid)
        pid = proc_ppid(pid)
    return chain


def find_agent_pid(agent: str) -> int:
    """Nearest ancestor whose cmdline mentions the agent binary.

    Hooks may be spawned through an intermediate shell, so getppid() alone
    isn't reliable — walk upward and match on cmdline.
    """
    for pid in ancestors(os.getppid()):
        if agent in proc_cmdline(pid):
            return pid
    return os.getppid()


def alive(entry: dict) -> bool:
    pid = entry.get("pid")
    if pid is None:
        return time.time() - entry.get("updated_at", 0) < STALE_SECONDS
    start = proc_start_time(pid)
    if start is None:
        return False  # /proc/<pid> gone
    recorded = entry.get("pid_start")
    return recorded is None or start == recorded


def prune(state: dict) -> dict:
    return {sid: e for sid, e in state.items() if alive(e)}


# ── Ingest ────────────────────────────────────────────────────────────

def classify_notification(message: str) -> str | None:
    """Map a Claude Notification message to a status, or None to ignore."""
    msg = message.lower()
    if any(k in msg for k in ("permission", "approval", "needs your")):
        return "permission"
    if "waiting for your input" in msg:
        return "waiting"
    return None


def ingest(agent: str) -> None:
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError:
        return

    if os.environ.get("AGENT_SESSION_HOOK_DEBUG") == "1":
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        with DEBUG_LOG.open("a") as f:
            f.write(f"{time.strftime('%F %T')} [{agent}] {json.dumps(payload)}\n")

    session_id = payload.get("session_id")
    if not session_id:
        return
    # Normalize event names: Claude uses CamelCase, codex may use snake_case.
    event = payload.get("hook_event_name", "").replace("_", "").lower()

    status = None
    remove = False
    if event == "sessionstart":
        status = "working" if payload.get("source") == "compact" else "waiting"
    elif event == "userpromptsubmit":
        status = "working"
    elif event == "posttooluse":
        status = "working"  # heartbeat; also clears a granted permission
    elif event == "stop":
        status = "waiting"
    elif event == "sessionend":
        remove = True
    elif event == "notification":
        status = classify_notification(payload.get("message", ""))
    elif event == "permissionrequest":
        status = "permission"
    if status is None and not remove:
        return

    fd = locked_lock_fd()
    if fd is None:
        return
    try:
        state = prune(load_state())
        if remove:
            state.pop(session_id, None)
        else:
            entry = state.get(session_id)
            if entry is None:
                # Only session-start / prompt events may create entries;
                # a stray Stop/Notification must not spawn a ghost blob.
                if event not in ("sessionstart", "userpromptsubmit"):
                    return
                pid = find_agent_pid(agent)
                entry = {
                    "agent": agent,
                    "cwd": payload.get("cwd", ""),
                    "model": payload.get("model"),
                    "pid": pid,
                    "pid_start": proc_start_time(pid),
                    "started_at": time.time(),
                }
                # /clear and /compact issue a new session_id in the same
                # process — drop the old entry so blobs don't duplicate.
                state = {sid: e for sid, e in state.items()
                         if e.get("pid") != pid or sid == session_id}
            entry["status"] = status
            entry["updated_at"] = time.time()
            if payload.get("cwd"):
                entry["cwd"] = payload["cwd"]
            if payload.get("model"):
                entry["model"] = payload["model"]
            state[session_id] = entry
        save_state(state)
    finally:
        os.close(fd)


# ── Prune / focus / dump ──────────────────────────────────────────────

def do_prune() -> None:
    fd = locked_lock_fd()
    if fd is None:
        return
    try:
        state = load_state()
        pruned = prune(state)
        if pruned != state:
            save_state(pruned)
    finally:
        os.close(fd)


def do_focus(session_id: str) -> int:
    entry = load_state().get(session_id)
    if not entry:
        return 1
    try:
        out = subprocess.run(["niri", "msg", "--json", "windows"],
                             capture_output=True, text=True, timeout=3)
        windows = json.loads(out.stdout)
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        return 1
    by_pid = {w["pid"]: w["id"] for w in windows if w.get("pid") is not None}

    window_id = None
    pid = entry.get("pid")
    if pid:
        for ancestor in ancestors(pid):
            if ancestor in by_pid:
                window_id = by_pid[ancestor]
                break
    if window_id is None:
        # Multiplexer fallback: unique title match on the cwd basename.
        needle = os.path.basename(entry.get("cwd", "").rstrip("/"))
        if needle:
            matches = [w["id"] for w in windows if needle in (w.get("title") or "")]
            if len(matches) == 1:
                window_id = matches[0]
    if window_id is None:
        return 1
    subprocess.run(["niri", "msg", "action", "focus-window", "--id", str(window_id)],
                   capture_output=True, timeout=3)
    return 0


def main() -> int:
    args = build_parser().run()
    if args.agent:
        try:
            ingest(args.agent)
        except Exception:
            pass  # never break an agent turn
        return 0
    if args.prune:
        do_prune()
        return 0
    if args.focus:
        return do_focus(args.focus)
    if args.dump:
        print(json.dumps(load_state(), indent=2))
        return 0
    build_parser().print_help()
    return 0


if __name__ == "__main__":
    sys.exit(main())
